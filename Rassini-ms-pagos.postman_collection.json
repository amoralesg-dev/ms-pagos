              "\r",
              "// Guardar token\r",
              "pm.environment.set(\"access_token\", json.access_token);\r",
              "\r",
              "// Guardar tipo (Bearer)\r",
              "pm.environment.set(\"token_type\", json.token_type);\r",
              "\r",
              "// Guardar expiración (opcional)\r",
              "pm.environment.set(\"expires_at\", json.expires_at);\r",
              "\r",
